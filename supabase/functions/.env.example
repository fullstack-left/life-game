# Copy to supabase/functions/.env for `supabase functions serve --env-file supabase/functions/.env`.
# In production set these with: supabase secrets set --env-file supabase/functions/.env.production
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

ENVIRONMENT=development

# Must match the key embedded in the client (scripts/generate-client-secret.mjs).
# Default below is the committed DEV key — NEVER use it in production.
CLIENT_HMAC_SECRET=local-dev-hmac-secret-change-me-0123456789

# Upstash Redis (rate limiting). Required when ENVIRONMENT=production (fails closed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Supavisor transaction-mode pooler for direct SQL settlement (port 6543).
# postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_POOLER_URL=
