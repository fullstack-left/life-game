# Fastlane — alternative to EAS Build for teams running their own macOS/Linux runners.
# Native projects are generated on demand (Continuous Native Generation):
#   npx expo prebuild --clean
# Required env: MATCH_PASSWORD, APP_STORE_CONNECT_API_KEY_JSON, SUPPLY_JSON_KEY_DATA,
#               LIFEGAME_CLIENT_HMAC_SECRET, EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY

default_platform(:ios)

before_all do
  sh("npm ci")
  sh("npm run verify")
  sh("npm run secret:generate") # embeds the obfuscated production HMAC key
  sh("npx expo prebuild --clean --no-install")
end

platform :ios do
  desc "Build a signed IPA and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    api_key = app_store_connect_api_key(key_content: ENV["APP_STORE_CONNECT_API_KEY_JSON"], is_key_content_base64: true)
    match(type: "appstore", readonly: true, api_key: api_key)
    cocoapods(podfile: "../ios/Podfile")
    increment_build_number(xcodeproj: "../ios/LifeSimulator.xcodeproj", build_number: latest_testflight_build_number(api_key: api_key) + 1)
    build_app(workspace: "../ios/LifeSimulator.xcworkspace", scheme: "LifeSimulator", export_method: "app-store")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end

platform :android do
  desc "Build a signed AAB and upload to the Play internal track"
  lane :beta do
    gradle(project_dir: "../android", task: "bundle", build_type: "Release")
    upload_to_play_store(track: "internal", release_status: "draft", json_key_data: ENV["SUPPLY_JSON_KEY_DATA"])
  end
end
