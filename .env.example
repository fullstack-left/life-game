# Copy to .env.local. Only EXPO_PUBLIC_* values are inlined into the JS bundle —
# they are PUBLIC by design (security lives in RLS + Edge Functions).
# Leave both empty to run the fully offline single-player edition (local economy).

# `npx supabase status` prints these for the local stack:
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
